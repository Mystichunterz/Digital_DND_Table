{
  "name": "digital_dnd_table",
  "private": true,
  "version": "1.0.1",
  "description": "BG3-styled D&D companion app: character sheet, action HUD, spellbook, journal and asset manager.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev:api\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "node scripts/asset-manager-server.mjs",
    "build": "vite build",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,jsx,scss}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,scss}\" \"scripts/**/*.mjs\"",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "backup:moodboard": "node scripts/backup-moodboard.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "express": "^5.2.1",
    "gray-matter": "^4.0.3",
    "multer": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-draggable": "^4.4.6",
    "react-markdown": "^10.1.0",
    "react-resizable": "^3.0.5",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^4.1.12",
    "concurrently": "^9.2.1",
    "eslint": "^9.18.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.4.2",
    "sass-embedded": "^1.83.3",
    "vite": "^6.0.5",
    "vitest": "^4.1.12"
  },
  "author": "",
  "license": "ISC"
}
